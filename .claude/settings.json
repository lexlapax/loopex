{
  "permissions": {
    "allow": [
      "Bash(mix test)",
      "Bash(mix test *)",
      "Bash(mix format)",
      "Bash(mix format *)",
      "Bash(mix compile)",
      "Bash(mix compile *)",
      "Bash(mix credo *)",
      "Bash(mix dialyzer *)",
      "Bash(mix xref *)",
      "Bash(mix deps.get)",
      "Bash(mix loopex.gate *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git worktree *)"
    ],
    "deny": [
      "Read(~/.loopex/**)",
      "Bash(* ~/.loopex *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-bash.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/after-edit.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-gate.sh",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
