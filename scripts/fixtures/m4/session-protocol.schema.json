{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loopex.dev/schema/experimental/session-protocol-1",
  "title": "Loopex experimental session protocol generation 1",
  "type": "object",
  "required": ["type"],
  "properties": {
    "type": {"type": "string", "minLength": 1, "maxLength": 64},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "command_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "session_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "turn_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "tool_call_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
    "interaction_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "event_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "stream_domain_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "admission": {"enum": ["accepted", "refused"]},
    "kind": {"type": "string", "minLength": 1, "maxLength": 64},
    "event_cursor": {"type": "integer", "minimum": 0},
    "event_sequence": {"type": "integer", "minimum": 0},
    "base_event_sequence": {"type": "integer", "minimum": 0},
    "model_sequence": {"type": "integer", "minimum": 0},
    "progress_sequence": {"type": "integer", "minimum": 0},
    "content_index": {"type": "integer", "minimum": 0},
    "call_index": {"type": "integer", "minimum": 0},
    "byte_offset": {"type": "integer", "minimum": 0},
    "delta_count": {"type": "integer", "minimum": 0},
    "progress_count": {"type": "integer", "minimum": 0},
    "text": {"type": "string"},
    "name": {"type": ["string", "null"]},
    "arguments_fragment": {"type": ["string", "null"]},
    "stream": {"enum": ["stdout", "stderr", "progress"]},
    "chunk": {"type": "string"},
    "disposition": {"enum": ["complete", "abandoned"]},
    "outcome": {"type": "string", "minLength": 1, "maxLength": 64},
    "active_run_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
    "protocol": {"const": "loopex.experimental/1"},
    "schema_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "method": {"type": "string", "minLength": 1, "maxLength": 64},
    "params": {"type": "object"},
    "result": {"type": "object"},
    "error": {"type": "object"}
  },
  "additionalProperties": true
}
