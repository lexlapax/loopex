{
  "contract": "standalone_compact_result",
  "revision": 1,
  "required": [
    "disposition",
    "checkpoint_id",
    "failure",
    "usage",
    "cleanup"
  ],
  "additional_members": "refuse",
  "disposition": {
    "checkpointed": {
      "checkpoint_id": "required",
      "failure": null,
      "cleanup": "confirmed"
    },
    "unchanged": {
      "checkpoint_id": null,
      "failure": null,
      "cleanup": "confirmed"
    },
    "failed": {
      "checkpoint_id": "nullable",
      "failure": "required",
      "cleanup": [
        "confirmed",
        "unknown"
      ]
    }
  },
  "checkpoint_id": {
    "encoding": "unpadded_base64url_of_original_opaque_bytes",
    "original_min_bytes": 1,
    "original_max_bytes": 65536
  },
  "usage": {
    "required": [
      "attempts",
      "reported_tokens",
      "estimated_tokens",
      "total_tokens"
    ],
    "additional_members": "refuse",
    "encoding": "canonical_decimal_string",
    "domain": "arbitrary_nonnegative_integer",
    "relation": "total_tokens = reported_tokens + estimated_tokens"
  },
  "failure": {
    "additional_members": "refuse",
    "retryable": false,
    "simple": {
      "categories": [
        "model_call_failed",
        "cancelled"
      ],
      "required": [
        "category",
        "retryable"
      ]
    },
    "bound_reached": {
      "required": [
        "category",
        "retryable",
        "bound",
        "observed",
        "declared_limit",
        "accounting_source"
      ],
      "bounds": [
        "max_attempts",
        "deadline_ms",
        "token_budget"
      ],
      "accounting_source": [
        null,
        "reported",
        "estimated"
      ],
      "max_attempts_accounting_source": null,
      "observed": "nonnegative_integer",
      "declared_limit": "positive_integer",
      "deadline_ms": "u64",
      "attempts_and_tokens": "arbitrary_integer",
      "relation": "no observed versus declared_limit requirement; reservation may refuse below limit"
    },
    "numeric_v2": {
      "required": [
        "version",
        "category",
        "retryable",
        "measurement_scope",
        "dimension",
        "observed",
        "limit",
        "hard_limit"
      ],
      "version": 2,
      "categories": [
        "context_budget_exceeded",
        "thinking_exchange_headroom"
      ],
      "measurement_scope": [
        "ordinary",
        "maintenance"
      ],
      "dimensions": [
        "system_class_tokens",
        "context_tokens",
        "context_record_bytes",
        "context_record_depth",
        "context_record_cardinality"
      ],
      "observed": "nonnegative_u64",
      "limit_and_hard_limit": "positive_u64",
      "context_record_bytes_hard_limit": "65536",
      "context_budget_exceeded": "limit = hard_limit; system_class_tokens observed >= limit, otherwise observed > limit",
      "thinking_exchange_headroom": "context_tokens or context_record_bytes; limit <= hard_limit and observed > limit"
    },
    "preparation_v2": {
      "required": [
        "version",
        "category",
        "retryable",
        "measurement_scope",
        "cause"
      ],
      "version": 2,
      "category": "context_preparation_failed",
      "measurement_scope": [
        null,
        "ordinary"
      ],
      "causes": [
        "maintenance_model_unconfigured",
        "maintenance_instructions_unconfigured",
        "maintenance_reasoning_unsupported",
        "compaction_excerpt_budget_too_small",
        "compaction_no_progress",
        "compaction_preparation_deadline",
        "maintenance_deadline_unrepresentable",
        "maintenance_summary_incomplete",
        "maintenance_summary_invalid",
        "canonical_history_rendering_unsupported",
        "artifact_read_unavailable",
        "artifact_metadata_unrepresentable",
        "artifact_preparation_count_exhausted",
        "artifact_preparation_bytes_exhausted",
        "artifact_preparation_deadline",
        "artifact_preparation_failed",
        "context_projection_invalid"
      ]
    }
  },
  "presentation": "enclosing_transport_owns_framing_and_ceiling"
}
